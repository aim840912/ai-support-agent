generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id                   String   @id @default(cuid())
  name                 String
  apiKey               String   @unique // Raw key — kept for display/embed snippet in settings UI
  apiKeyHash           String?  @unique // sha256(apiKey) — used for widget authentication lookups.
  // Nullable during migration; populated for all new orgs.
  // Run: pnpm prisma migrate deploy (see migrations/add_api_key_hash)
  plan                 String   @default("free") // free | pro
  settings             Json? // { theme, welcomeMessage, ... }
  stripeCustomerId     String?  @unique
  stripeSubscriptionId String?
  createdAt            DateTime @default(now())

  users         User[] // Legacy: users whose orgId FK points here
  activeUsers   User[]             @relation("activeOrg") // Users with this as their active org
  members       UserOrganization[] // Multi-org membership join table
  documents     Document[]
  chatSessions  ChatSession[]
  agentSettings AgentSettings?
  products      Product[]
  orders        Order[]
  tickets       Ticket[]
  invitations   Invitation[]

  // Integrations
  telegramChannel   TelegramChannel?
  webhookEndpoints  WebhookEndpoint[]
  webhookDeliveries WebhookDelivery[]
  integrationKeys   IntegrationKey[]
}

model User {
  id                String        @id @default(cuid())
  email             String        @unique
  emailVerified     DateTime?
  image             String?
  password          String? // hashed, null if OAuth
  name              String?
  role              String        @default("member") // owner | admin | member (legacy — role is now per-org in UserOrganization)
  orgId             String // Legacy: original org this user was created with
  org               Organization  @relation(fields: [orgId], references: [id])
  activeOrgId       String? // Current active org; drives session.user.orgId
  activeOrg         Organization? @relation("activeOrg", fields: [activeOrgId], references: [id])
  createdAt         DateTime      @default(now())
  passwordChangedAt DateTime? // Set on password reset; JWT tokens issued before this timestamp are invalidated

  organizations UserOrganization[] // All org memberships (multi-org support)
  accounts      Account[] // NextAuth
  sessions      Session[] // NextAuth
}

// Join table: one user can belong to many organizations with different roles.
// role field shadows User.role (which is kept for backward compat during Migration A).
model UserOrganization {
  id     String @id @default(cuid())
  userId String
  orgId  String
  role   String @default("member") // owner | admin | member

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, orgId]) // One membership record per user-org pair
  @@index([userId])
  @@index([orgId])
}

model Document {
  id         String       @id @default(cuid())
  filename   String
  status     String       @default("processing") // processing | ready | error
  chunkCount Int          @default(0)
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id])
  createdAt  DateTime     @default(now())

  embeddings Embedding[]
}

model Embedding {
  id         String                     @id @default(cuid())
  chunkText  String
  vector     Unsupported("vector(768)") // Gemini gemini-embedding-001, 768 dims
  documentId String
  document   Document                   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  orgId      String // denormalized for fast multi-tenant filtering

  @@index([orgId])
}

model ChatSession {
  id        String       @id @default(cuid())
  visitorId String? // anonymous visitor ID
  userId    String? // authenticated user ID
  orgId     String
  source    String       @default("widget") // widget | dashboard | api | telegram
  org       Organization @relation(fields: [orgId], references: [id])
  createdAt DateTime     @default(now())

  messages ChatMessage[]

  // Messaging channels look up an existing session by (org, channel, external
  // identity) on every inbound message. Without this the lookup is a seq scan.
  @@index([orgId, source, visitorId])
}

model ChatMessage {
  id        String      @id @default(cuid())
  role      String // user | assistant | tool
  content   String
  sources   Json? // [{ documentId, chunkText, score }]
  toolCalls Json? // Vercel AI SDK tool call records
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
}

model AgentSettings {
  id             String       @id @default(cuid())
  orgId          String       @unique
  org            Organization @relation(fields: [orgId], references: [id])
  systemPrompt   String?
  welcomeMessage String       @default("您好！我是 AI 客服，有什麼可以幫助您的嗎？")
  theme          Json? // { primaryColor, logoUrl }
  enabledTools   String[]     @default(["searchKnowledgeBase"])
}

// NextAuth required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── E-commerce domain models ─────────────────────────────────────────────

model Product {
  id               String       @id @default(cuid())
  name             String
  sku              String       @unique
  stockLevel       Int          @default(0)
  warehouse        String
  reorderThreshold Int          @default(10)
  price            Decimal      @default(0) @db.Decimal(10, 2)
  orgId            String
  org              Organization @relation(fields: [orgId], references: [id])
  createdAt        DateTime     @default(now())

  orderItems OrderItem[]

  @@index([orgId])
}

model Order {
  id                String       @id @default(cuid())
  orderNumber       String       @unique
  status            String       @default("pending") // pending | processing | shipped | delivered | cancelled
  trackingNumber    String?
  estimatedDelivery DateTime?
  totalPrice        Decimal      @default(0) @db.Decimal(10, 2)
  customerId        String? // external customer identifier
  orgId             String
  org               Organization @relation(fields: [orgId], references: [id])
  createdAt         DateTime     @default(now())

  items   OrderItem[]
  tickets Ticket[]

  @@index([orgId])
}

model OrderItem {
  id        String  @id @default(cuid())
  quantity  Int     @default(1)
  unitPrice Decimal @default(0) @db.Decimal(10, 2)
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
}

model Ticket {
  id           String       @id @default(cuid())
  ticketNumber String       @unique
  subject      String
  description  String
  priority     String       @default("medium") // low | medium | high | urgent
  status       String       @default("open") // open | in_progress | resolved | closed
  orderId      String?
  order        Order?       @relation(fields: [orderId], references: [id])
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  notes TicketNote[]

  @@index([orgId])
}

model TicketNote {
  id        String   @id @default(cuid())
  content   String
  authorId  String // userId of the staff member who wrote the note
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([ticketId])
}

model Invitation {
  id        String       @id @default(cuid())
  email     String
  role      String       @default("member") // admin | member
  token     String       @unique
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invitedBy String // userId of the inviter
  expires   DateTime
  createdAt DateTime     @default(now())

  @@index([orgId])
  @@index([token])
}

// ─────────────────────────────────────────────────────────────────────────────
// Integrations
// ─────────────────────────────────────────────────────────────────────────────

/// Inbound Telegram bot for one organization.
model TelegramChannel {
  id    String       @id @default(cuid())
  orgId String       @unique
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  /// Opaque path segment for the webhook URL. Deliberately NOT the orgId: this
  /// URL is stored on Telegram's servers and appears in our own logs, so using
  /// the tenant id would broadcast it and make tenants enumerable.
  webhookId String @unique

  /// AES-256-GCM envelope — see src/lib/crypto/secrets.ts. Encrypted because a
  /// leak lets an attacker act as the customer's bot towards their end users,
  /// which is damage outside this system's blast radius.
  botToken String

  /// From getMe, shown in settings so the user can confirm the right bot.
  botUsername String?

  /// sha256 of the value passed to Telegram as secret_token, compared with
  /// timingSafeEqual. Knowing the webhook URL is therefore not enough to forge
  /// an update.
  secretTokenHash String

  enabled     Boolean   @default(true)
  lastEventAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/// A customer-supplied URL that receives outbound events (n8n, Zapier, ...).
model WebhookEndpoint {
  id  String @id @default(cuid())
  url String

  /// Plaintext by design — recomputed on every delivery to sign the payload,
  /// and shown in the dashboard so it can be pasted into the receiving tool.
  /// See src/lib/crypto/secrets.ts for the full reasoning.
  secret String

  events      String[] @default(["ticket.created"])
  enabled     Boolean  @default(true)
  description String?

  /// Last HTTP status; null when the request never completed (timeout, DNS).
  lastStatus  Int?
  lastFiredAt DateTime?

  /// Consecutive failures. The endpoint is auto-disabled once this hits the
  /// threshold, so a dead URL stops burning a delivery attempt per event.
  failureCount Int @default(0)

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  createdAt  DateTime          @default(now())
  deliveries WebhookDelivery[]

  @@index([orgId])
  @@index([orgId, enabled])
}

/// One delivery attempt. Capped per endpoint — this is a debugging aid, not an
/// audit log.
model WebhookDelivery {
  id String @id @default(cuid())

  event String

  /// Also sent as the X-Webhook-Id header and embedded in the payload, so the
  /// receiver can deduplicate. That is what turns replay *resistance* (the
  /// signed timestamp) into actual replay prevention.
  eventId String

  status     String // success | failed
  statusCode Int? // null = request never completed
  durationMs Int
  attempt    Int     @default(1)
  error      String?

  /// Truncated. The only way to debug a field-mapping problem in the receiving
  /// tool — at the cost of ticket text (possibly containing customer data)
  /// living in a second table.
  requestBody  String? @db.Text
  responseBody String? @db.Text

  endpointId String
  endpoint   WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  /// Denormalised, following the precedent set by Embedding.orgId: lets the
  /// dashboard scope deliveries by tenant without joining through the endpoint.
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([endpointId, createdAt])
  @@index([orgId, createdAt])
}

/// Credential for machine access (MCP clients, automation). Separate from
/// Organization.apiKey on purpose: that key is printed into the customer's own
/// web page for the chat widget and is therefore public, whereas these tools
/// read orders and create tickets.
model IntegrationKey {
  id   String @id @default(cuid())
  name String // "Claude Desktop — laptop", "n8n prod"

  /// sha256 of the raw key. The raw value is returned exactly once, at creation.
  keyHash String @unique

  /// First few characters, for identifying a key in a list. Prefixed `mcp_`
  /// rather than `sk_` so the two credential families are distinguishable in logs.
  keyPrefix String

  scopes     String[]  @default(["mcp:tools"])
  lastUsedAt DateTime?
  revokedAt  DateTime?
  expiresAt  DateTime?

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([orgId])
}
