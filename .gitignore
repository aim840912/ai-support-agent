# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.stackdump

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel
*vercel*.env

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma generated client (~10MB WASM binaries — regenerated by "prisma generate" at build time)
/src/generated/prisma/

# screenshots (local dev only)
/screenshots/

# accidentally created literal ~/ directory
/~/
.playwright-mcp/
.dev-server.log
dev-server.log

# claude local settings (machine-specific, contains absolute paths)
.claude/settings.local.json
# Local test fixtures and credentials. This repo is public — never track these.
.claude/test.config.md
