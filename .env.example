# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# NextAuth
AUTH_SECRET=""              # openssl rand -base64 32
AUTH_URL="http://localhost:3000"

# Google Gemini (Embedding)
GOOGLE_GENERATIVE_AI_API_KEY=""

OPENROUTER_API_KEY=""

# Groq (LLM)
GROQ_API_KEY=""

# OAuth Providers (Phase 3)
# Google: https://console.cloud.google.com/ → Credentials → OAuth 2.0 Client
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub: https://github.com/settings/apps → New OAuth App
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Email (Resend) — https://resend.com
RESEND_API_KEY=""           # re_xxxxxxxxxxxx
EMAIL_FROM="AI Support Agent <noreply@yourdomain.com>"

# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=""                  # sk_live_xxx or sk_test_xxx
STRIPE_WEBHOOK_SECRET=""              # whsec_xxx (from stripe listen or dashboard)
NEXT_PUBLIC_STRIPE_PRICE_ID=""        # price_xxx (your Pro plan monthly price)

# ─── App ───────────────────────────────────────────────────────────────────
# Base URL used for the widget iframe src and for links inside webhook payloads.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Integrations ──────────────────────────────────────────────────────────
# Master key for encrypting third-party channel credentials (Telegram bot
# tokens). Must decode to exactly 32 bytes. Generate with:
#   openssl rand -base64 32
# Missing or malformed values fail fast — the app will never silently fall back
# to storing credentials in plaintext.
INTEGRATION_ENCRYPTION_KEY=""

# Outbound webhook delivery tuning. Vercel has no background worker, so these
# bound a single request: at most WEBHOOK_MAX_ATTEMPTS tries of
# WEBHOOK_TIMEOUT_MS each. This is at-most-a-few-attempts, not at-least-once.
WEBHOOK_TIMEOUT_MS="4000"
WEBHOOK_MAX_ATTEMPTS="2"

# Base URL third parties call back on (Telegram webhooks, links inside webhook
# payloads). Only needed when it differs from NEXT_PUBLIC_APP_URL — in local
# development, set this to the tunnel hostname:
#   cloudflared tunnel --url http://localhost:3000
# Telegram refuses a non-HTTPS webhook, so localhost will not work.
INTEGRATIONS_PUBLIC_URL=""
